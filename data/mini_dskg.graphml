<node id="paper:W4394143564">
  <data key="d0">Paper</data>
  <data key="d1">MovieLens Search</data>
  <data key="d6">MovieLens Search</data>
  <data key="d5">2014</data>
  <data key="d7">https://doi.org/10.6084/m9.figshare.1254624</data>
  <data key="d8">0</data>
  <data key="d9">This dataset contains all of the search events for users of the MovieLens recommender engine.</data>
