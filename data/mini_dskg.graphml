<node id="paper:W7164002385">
  <data key="d0">Paper</data>
  <data key="d1">Domain-Specific Fine-Tuning Of 3B-Parameter Models Performance On Exact Match Accuracy On Hotpotqa When Integrated With</data>
  <data key="d6">Domain-Specific Fine-Tuning Of 3B-Parameter Models Performance On Exact Match Accuracy On Hotpotqa When Integrated With</data>
  <data key="d5">2026</data>
