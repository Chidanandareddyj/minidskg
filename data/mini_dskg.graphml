  <data key="d0">Author</data>
  <data key="d1">Egor Burkov</data>
</node>
<node id="author:victor lempitsky">
  <data key="d0">Author</data>
  <data key="d1">Victor Lempitsky</data>
</node>
<node id="author:yury a. malkov">
  <data key="d0">Author</data>
  <data key="d1">Yury A. Malkov</data>
