<node id="paper:W4393524337">
  <data key="d0">Paper</data>
  <data key="d1">Pre-processed XSum and CNN/Dailymail for BERT-based summarization</data>
  <data key="d6">Pre-processed XSum and CNN/Dailymail for BERT-based summarization</data>
  <data key="d5">2019</data>
  <data key="d7">https://doi.org/10.5281/zenodo.4562809</data>
