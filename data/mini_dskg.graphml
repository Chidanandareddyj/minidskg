  <data key="d6">KITTI 3D Object Detection</data>
  <data key="d5">2022</data>
  <data key="d7">https://doi.org/10.5281/zenodo.7046094</data>
  <data key="d8">0</data>
  <data key="d9">The dataset downloaded from official KITTI website was used in eGAC3D's evaluation. This dataset includes raw images (data_object_label_2.zip) and corresponding ground-truth (data_object_image_2.zip).</data>
